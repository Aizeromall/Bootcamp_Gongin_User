# 작업자 : 최현준
# 간편 로그인 설정 추가 일 : 2026-10-28 (기존 환경변수 유지)
# 실제 값은 로컬 .env에 입력합니다. 비밀키 및 서비스 계정 JSON은 Git/Flutter assets에 포함하지 않습니다.
DB_HOST=192.168.20.54
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
API_HOST=0.0.0.0
API_PORT=8000
# Google 로그인: 기존 Firebase 프로젝트 및 서버 자격 증명 사용
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# 일반 로그인 JWT 서명키: 32바이트 이상, 운영 서버 간 동일한 비밀값 사용 (Git 등록 금지)
AUTH_TOKEN_SECRET=
# AUTH_TOKEN(JWT Token 발급 방법)
# Terminal에 openssl rand -hex 32 <- 입력 후 64글자 문자열 붙여 넣기

# Kakao 로그인 - 서버에서 인가 코드를 교환하는 REST API 방식 준비
# 카카오디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키 및 클라이언트 시크릿
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 모바일 토큰 검증용 숫자 앱 ID (카카오 개발자 콘솔의 앱 ID, API 키와 다릅니다)
KAKAO_APP_ID=
# 콘솔 등록값과 실제 요청값이 정확히 같아야 합니다.
# 개발 예시: http://localhost:8000/auth/kakao/callback (운영은 실제 HTTPS 주소)
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# Naver 로그인 - 네이버 개발자센터 > 내 애플리케이션 > Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 실기기는 localhost 대신 폰에서도 접근 가능한 서버 주소를 사용합니다. 운영은 HTTPS 필수입니다.
NAVER_REDIRECT_URI=http://localhost:8000/auth/naver/callback

# 세부 설정: docs/social_login_setup.md
# Backend API는 /docs에서 확인합니다. 모바일 앱 설정은 docs/mobile_auth_notification_setup.md를 참조하세요.
# 최종 수정 일 : 2026-10-28
